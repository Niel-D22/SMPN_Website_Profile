# Port server Express (default: 3000)
PORT=3000

# Connection string PostgreSQL dari Supabase
# Dashboard Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Secret key untuk JWT — buat sendiri secara random, jangan dibagikan
JWT_SECRET=isi_secret_key_anda_di_sini

# URL frontend untuk link reset password
# Development: http://localhost:5173
# Production: https://domain-frontend-anda.com
FRONTEND_URL=http://localhost:5173

# API key Resend untuk pengiriman email
# Dashboard Resend → API Keys
RESEND_API_KEY=isi_resend_api_key_di_sini

# Kredensial Cloudinary untuk upload media
# Dashboard Cloudinary → Account Details
CLOUDINARY_CLOUD_NAME=isi_cloud_name_di_sini
CLOUDINARY_API_KEY=isi_api_key_di_sini
CLOUDINARY_API_SECRET=isi_api_secret_di_sini

# Kredensial Supabase (untuk Supabase client)
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=isi_service_role_key_di_sini
